# ── Global ──────────────────────────────────────────────
font=MesloLGS Nerd Font Mono Bold 11
background-color=#111827F2
text-color=#cdd6f4
border-color=#6366f1
border-size=2
border-radius=12
padding=12,16
margin=10
width=380
height=140
max-icon-size=48
icon-location=left
default-timeout=5000
ignore-timeout=1
layer=overlay
anchor=top-right
outer-margin=8
group-by=app-name
max-visible=5
markup=1
actions=1
format=<b>%s</b>\n%b
progress-color=over #6366f155

# ── On hover ────────────────────────────────────────────
[mode=do-not-disturb]
invisible=1

# ── Per-urgency ─────────────────────────────────────────
[urgency=low]
border-color=#6b7280
default-timeout=4000

[urgency=normal]
border-color=#6366f1

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

# ── App-specific tweaks ─────────────────────────────────
[app-name=Spotify]
border-color=#a6e3a1
default-timeout=3000

[app-name=volume]
default-timeout=1500
group-by=app-name
